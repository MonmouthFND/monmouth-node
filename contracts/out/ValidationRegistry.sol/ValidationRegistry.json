"responseHash\",\"type\":\"bytes32\"},{\"internalType\":\"string\",\"name\":\"tag\",\"type\":\"string\"}],\"name\":\"validationResponse\",\"outputs\":[],\"stateMutability\":\"nonpayable\",\"type\":\"function\"}],\"devdoc\":{\"author\":\"Monmouth Team\",\"details\":\"Enables validators to independently verify agent capabilities through      a request-response pattern. Validation requests are indexed by their      content hash, and responses include tags for categorization.      Security: custom errors, events on all state changes,      input validation, agent existence verification via IdentityRegistry.\",\"kind\":\"dev\",\"methods\":{\"constructor\":{\"params\":{\"_identityRegistry\":\"Address of the IdentityRegistry contract.\",\"_requestCooldown\":\"Minimum seconds between validation requests per sender. 0 = no cooldown.\"}},\"getAgentRequestAt(uint256,uint256)\":{\"params\":{\"agentId\":\"The agent to query.\",\"index\":\"The index in the agent's request list.\"},\"returns\":{\"requestHash\":\"The request hash at that index.\"}},\"getAgentRequestCount(uint256)\":{\"params\":{\"agentId\":\"The agent to query.\"},\"returns\":{\"count\":\"The number of validation requests.\"}},\"getRequest(bytes32)\":{\"params\":{\"requestHash\":\"The request hash.\"},\"returns\":{\"agentId\":\"The agent being validated.\",\"requester\":\"The address that created the request.\",\"responded\":\"Whether a response has been submitted.\",\"validator\":\"The designated validator.\"}},\"getResponse(bytes32)\":{\"params\":{\"requestHash\":\"The request hash.\"},\"returns\":{\"response\":\"The response code.\",\"responseHash\":\"The response content hash.\",\"responseURI\":\"The response data URI.\",\"tag\":\"The categorization tag.\"}},\"validationRequest(address,uint256,string,bytes32)\":{\"details\":\"The requestHash serves as the unique identifier for the request.      It must not have been used before.      IMPORTANT: To prevent front-running, callers SHOULD include msg.sender      in 